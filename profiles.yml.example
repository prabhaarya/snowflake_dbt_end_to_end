# Copy these contents into ~/.dbt/profiles.yml
snowflake_profile:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: <your_snowflake_account_identifier>   # e.g., xy12345.us-central1.gcp or org-account
      user: CE_TEST
      password: <your_snowflake_password>
      role: SYSADMIN
      database: TOMWALL_DB
      warehouse: DWH_MIGRATIONS
      schema: TOMWALL_SCHEMA2
      threads: 4
      client_session_keep_alive: False

bigquery_profile:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: oauth                          # Uses gcloud auth application-default login
      project: <your_gcp_project_id>         # e.g., cloud-professional-services
      dataset: <your_bigquery_dataset>       # e.g., dbt_analytics (target dataset for created tables/views)
      threads: 4
      location: US                           # e.g., US, EU, us-central1
      timeout_seconds: 300
      priority: interactive

